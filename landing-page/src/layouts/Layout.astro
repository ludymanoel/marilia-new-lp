---
/**
 * Layout raiz. Inclui <head>, meta tags, OG, JSON-LD Schema.org,
 * preconnect de fontes externas, scripts de analytics.
 *
 * IMPORTANTE (LP-skill):
 * - Meta Pixel deve ser inicializado UMA VEZ no <head>
 * - Não duplicar init via JS dinâmico
 * - UTM tracking + repasse para checkout Kiwify
 */
import '../styles/global.css';
import { faqData, siteConfig } from '../data/content';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'Produtividade Sincera — O método pra quem não aguenta mais se sentir sobrecarregada',
  description = 'Em 30 dias, monte uma rotina sob medida com o Método Produtividade Sincera. 6 módulos, 2 bônus, 7 dias de garantia. +5.000 alunas.',
  ogImage = '/og-image.png',
  canonical = Astro.url.href,
} = Astro.props;

// FAQ schema (rich results do Google)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.questions.map((q) => ({
    '@type': 'Question',
    name: q.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.a,
    },
  })),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1E1B4B" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Marília Cordeiro" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Performance: preconnect -->
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://pay.kiwify.com.br" />

    <!-- Fonts: Fraunces (display) + Inter (body) com display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- ============================================================== -->
    <!-- META PIXEL — Inicializado UMA VEZ aqui no <head> -->
    <!-- NÃO duplicar init via JS (causa "Duplicate Pixel ID" error) -->
    <!-- ============================================================== -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', '678121427532401');
      window.fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=678121427532401&ev=PageView&noscript=1"
    /></noscript>

    <!-- ============================================================== -->
    <!-- TIKTOK PIXEL — Carregado de arquivo externo (não inline por causa de TS parsing) -->
    <!-- ============================================================== -->
    <script is:inline src="/tiktok-pixel.js" async></script>

    <!-- ============================================================== -->
    <!-- GOOGLE ADS + GA4 — via gtag.js consolidado -->
    <!-- ============================================================== -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-11264843190"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'AW-11264843190');
      gtag('config', 'G-YLQMHNNY87');
    </script>

    <!-- ============================================================== -->
    <!-- SCHEMA.ORG — Course (principal) -->
    <!-- ============================================================== -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: 'Produtividade Sincera',
      description: description,
      provider: {
        '@type': 'Person',
        name: 'Marília Cordeiro',
        sameAs: 'https://mariliacordeiro.com',
      },
      offers: {
        '@type': 'Offer',
        category: 'Curso online',
        price: '697.00',
        priceCurrency: 'BRL',
        availability: 'https://schema.org/InStock',
        url: siteConfig.checkoutUrl,
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.9',
        reviewCount: '5000',
        bestRating: '5',
        worstRating: '1',
      },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'online',
        courseWorkload: 'PT8H',
      },
    })} />

    <!-- ============================================================== -->
    <!-- SCHEMA.ORG — FAQPage (rich results do Google) -->
    <!-- ============================================================== -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- ============================================================== -->
    <!-- SCHEMA.ORG — BreadcrumbList -->
    <!-- ============================================================== -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Início',
          item: 'https://mariliacordeiro.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Produtividade Sincera',
          item: 'https://mariliacordeiro.com/produtividade-sincera/',
        },
      ],
    })} />

    <!-- ============================================================== -->
    <!-- SCHEMA.ORG — Organization -->
    <!-- ============================================================== -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Marília Cordeiro',
      url: 'https://mariliacordeiro.com',
      logo: 'https://mariliacordeiro.com/logo-completa-branco.svg',
      sameAs: [
        siteConfig.contact.instagram,
        siteConfig.contact.youtube,
        siteConfig.contact.linkedin,
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        email: siteConfig.contact.email,
        contactType: 'customer support',
        areaServed: 'BR',
        availableLanguage: 'Portuguese',
      },
    })} />
  </head>
  <body>
    <!-- Skip link para A11y -->
    <a href="#main" class="skip-link">Pular para o conteúdo principal</a>

    <slot />

    <!-- Scripts sempre ativos (sem consentimento) — reveal + tracking -->
    <script>
      // Reveal on scroll
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
      );
      document.querySelectorAll('.reveal, .stagger').forEach((el) => observer.observe(el));
    </script>

    <!-- Bundle do tracking (será gerado pelo Vite) -->
    <script>
      import('../scripts/tracking').then((m) => m.initTracking());
    </script>
  </body>
</html>