---
/**
 * LogoMC — Logo oficial Marília Cordeiro.
 *
 * Wordmark tipográfico "marília cordeiro" em SVG vetorial.
 *
 * Variantes:
 * - "color" → fundo claro (texto marinho)
 * - "light" → fundo escuro (texto branco)
 * - "mono" → cor sólida via currentColor
 */

export interface Props {
  variant?: 'color' | 'light' | 'mono';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showText?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'color',
  size = 'md',
  showText = true,
  class: className = '',
  ariaLabel = 'Marília Cordeiro',
} = Astro.props;

// Cores oficiais do brandbook
const COLORS = {
  brand: '#000154',
  white: '#FFFFFF',
};

const palette = {
  color: { text: COLORS.brand },
  light: { text: COLORS.white },
  mono: { text: 'currentColor' },
}[variant];

const dimensions = {
  sm: { w: 132, h: 48 },
  md: { w: 198, h: 72 },
  lg: { w: 264, h: 96 },
  xl: { w: 352, h: 128 },
}[size];

const { w, h } = dimensions;

// Usando viewBox do PNG original (2080x756) mantém fidelidade ao brandbook
const viewBoxWidth = 2080;
const viewBoxHeight = 756;

// Posição do wordmark (em coordenadas viewBox)
const wordmarkX = 836;
const wordmarkX2 = 780;
const wordmarkY1 = 410;
const wordmarkY2 = 720;
const wordmarkFontSize = 380;

const finalHeight = h;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={w}
  height={finalHeight}
  viewBox={`0 0 ${viewBoxWidth} ${viewBoxHeight}`}
  fill="none"
  class={className}
  aria-label={ariaLabel}
  role="img"
  preserveAspectRatio="xMinYMid meet"
>
  <title>{ariaLabel}</title>

  {showText && (
    <g aria-hidden="true">
      <text
        x={wordmarkX}
        y={wordmarkY1}
        font-family="'Config Rounded', 'Roboto', sans-serif"
        font-size={wordmarkFontSize}
        font-weight="700"
        fill={palette.text}
        text-anchor="start"
        letter-spacing="-10"
      >marília</text>

      <text
        x={wordmarkX2}
        y={wordmarkY2}
        font-family="'Config Rounded', 'Roboto', sans-serif"
        font-size={wordmarkFontSize}
        font-weight="700"
        fill={palette.text}
        text-anchor="start"
        letter-spacing="-10"
      >cordeiro</text>
    </g>
  )}
</svg>

<style>
  svg {
    display: inline-block;
    vertical-align: middle;
    max-width: 100%;
    height: auto;
  }
</style>