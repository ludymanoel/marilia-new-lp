---
/**
 * BeforeAfter — Comparação visual antes/depois (transformação).
 * Reforça visualmente o que muda na rotina da pessoa.
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { beforeAfterData, siteConfig } from '../../data/content';
---

<SectionWrapper theme="light" ariaLabelledby="before-after-heading">
  <SectionHeading
    eyebrow={beforeAfterData.eyebrow}
    title={beforeAfterData.headline}
    subtitle={beforeAfterData.subheadline}
    align="center"
  />

  <div class="grid md:grid-cols-2 gap-6 md:gap-8 mt-12 md:mt-16 max-w-5xl mx-auto stagger">
    <!-- SEM MÉTODO -->
    <article class="card border-2 border-rose-100 reveal">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center">
          <Icon name="x" size={20} />
        </div>
        <h3 class="text-xl font-display font-semibold text-rose-700">
          {beforeAfterData.without.label}
        </h3>
      </div>
      <ul class="space-y-3" role="list">
        {beforeAfterData.without.items.map((item) => (
          <li class="flex items-start gap-3 text-neutral-700 leading-relaxed">
            <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-rose-400 mt-2.5"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>

    <!-- COM MÉTODO -->
    <article class="card border-2 border-emerald-200 bg-emerald-50/30 reveal">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center">
          <Icon name="check" size={20} />
        </div>
        <h3 class="text-xl font-display font-semibold text-emerald-800">
          {beforeAfterData.withMethod.label}
        </h3>
      </div>
      <ul class="space-y-3" role="list">
        {beforeAfterData.withMethod.items.map((item) => (
          <li class="flex items-start gap-3 text-neutral-800 leading-relaxed">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center mt-0.5">
              <Icon name="check" size={12} />
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>

  <div class="text-center mt-12 reveal">
    <Button
      variant="primary"
      size="lg"
      href={siteConfig.checkoutUrl}
      external={true}
      showArrow={false}
      data-track-cta="before_after_cta"
    >
      {beforeAfterData.cta}
    </Button>
  </div>
</SectionWrapper>