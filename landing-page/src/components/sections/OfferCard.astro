---
/**
 * OfferCard — Baseado no KV aprovado da LP original.
 * Preço: R$ 1.497 → R$ 697 / 12x R$ 70,07
 * Inclui: lista oficial de benefícios + selos de pagamento + mockup do curso
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CountdownTimer from '../ui/CountdownTimer.astro';
import { offerData } from '../../data/content';
---

<SectionWrapper id="oferta" theme="dark" ariaLabelledby="offer-heading" containerClass="!max-w-narrow">
  <SectionHeading
    eyebrow={offerData.eyebrow}
    title={offerData.headline}
    subtitle={offerData.subheadline}
    align="center"
    invert
  />

  <!-- Card da oferta -->
  <article
    class="bg-white rounded-2xl shadow-2xl overflow-hidden text-neutral-900 mt-12 md:mt-16 reveal relative"
  >
    <!-- Top badge -->
    <div class="bg-yellow-500 text-brand-900 text-center py-3 font-bold text-sm uppercase tracking-widest">
      <Icon name="flame" size={16} class="inline -mt-0.5 mr-1" />
      Oferta especial — vagas limitadas
    </div>

    <div class="p-6 md:p-10">
      <!-- Âncora visual -->
      <div class="text-center mb-6">
        <div class="text-sm uppercase tracking-widest text-neutral-500 mb-1">
          {offerData.anchor}
        </div>
        <div class="flex items-baseline justify-center gap-2 mb-2">
          <span class="text-2xl md:text-3xl font-display text-neutral-400 line-through">
            R$ 1.497
          </span>
        </div>
        <div class="font-display font-bold text-4xl md:text-5xl text-brand-700 tabular-nums leading-none">
          {offerData.price.main}
        </div>
        <div class="text-base text-neutral-600 mt-2">
          {offerData.price.secondary}
        </div>
      </div>

      <!-- Divisor -->
      <hr class="border-neutral-200 my-6" />

      <!-- Countdown -->
      <div class="mb-6">
        <CountdownTimer initialHours={offerData.countdown.durationHours} label={offerData.countdown.label} />
      </div>

      <!-- O que está incluso -->
      <div class="mb-8">
        <h3 class="text-sm uppercase tracking-widest text-neutral-500 font-semibold mb-4">
          Você recebe:
        </h3>
        <ul class="space-y-3" role="list">
          {offerData.includes.map((item) => (
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-success-500 text-white flex items-center justify-center mt-0.5">
                <Icon name="check" size={12} />
              </span>
              <span class="text-neutral-800 text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div class="space-y-3">
        <Button
          variant="primary"
          href={offerData.cta.href}
          external={true}
          size="lg"
          ariaLabel={offerData.cta.text}
          data-track-cta="offer_card_main"
          class="w-full"
        >
          <Icon name="rocket" size={20} />
          {offerData.cta.text}
        </Button>
        <p class="text-center text-sm text-neutral-600">
          {offerData.microcopy}
        </p>
      </div>

      <!-- Formas de pagamento (imagem oficial com os elementos visuais) -->
      <div class="mt-8 pt-6 border-t border-neutral-100 text-center">
        <p class="text-center text-xs uppercase tracking-widest text-neutral-500 font-semibold mb-3">
          Formas de pagamento
        </p>
        <img
          src="/images/image-2.webp"
          alt="Formas de pagamento: cartão, boleto e PIX"
          width="228"
          height="16"
          loading="lazy"
          decoding="async"
          class="mx-auto w-72 md:w-80 h-auto"
        />
      </div>

      <!-- Selos de segurança -->
      <ul class="grid grid-cols-3 gap-3 mt-6 text-center text-xs text-neutral-600" role="list">
        <li class="flex flex-col items-center gap-1">
          <Icon name="lock" size={20} class="text-success-500" />
          <span>Compra<br />segura</span>
        </li>
        <li class="flex flex-col items-center gap-1">
          <Icon name="shield-check" size={20} class="text-success-500" />
          <span>7 dias de<br />garantia</span>
        </li>
        <li class="flex flex-col items-center gap-1">
          <Icon name="rocket" size={20} class="text-success-500" />
          <span>Acesso<br />imediato</span>
        </li>
      </ul>
    </div>
  </article>
</SectionWrapper>