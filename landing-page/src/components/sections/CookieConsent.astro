---
/**
 * CookieConsent — Banner LGPD-compliant.
 *
 * Categorias:
 * - Essenciais (sempre ativos): sessionStorage de UTMs
 * - Analytics: GA4
 * - Marketing: Meta Pixel, TikTok Pixel, Google Ads
 *
 * Comportamento:
 * - Banner aparece após 1.5s se ainda não houve decisão
 * - "Aceitar tudo" habilita analytics + marketing
 * - "Rejeitar" desabilita marketing mas mantém essenciais
 * - "Configurar" abre painel de preferências
 * - Decisão persistida por 365 dias em localStorage
 */
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 md:bottom-4 md:left-4 md:right-auto md:max-w-md hidden"
  role="dialog"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-desc"
  data-cookie-banner
>
  <div class="bg-white border border-neutral-200 shadow-large rounded-t-2xl md:rounded-2xl p-5 m-0 md:m-2">
    <div class="flex items-start gap-3 mb-4">
      <div class="w-9 h-9 rounded-full bg-brand-100 flex items-center justify-center flex-shrink-0">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-700" aria-hidden="true">
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
          <path d="M8.5 8.5h.01"/><path d="M16 15.5h.01"/>
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <h2 id="cookie-banner-title" class="font-display font-semibold text-neutral-900 text-base mb-1">
          Sua privacidade importa
        </h2>
        <p id="cookie-banner-desc" class="text-sm text-neutral-600 leading-relaxed">
          Usamos cookies para entender como você usa o site e mostrar anúncios mais relevantes.
          Você pode aceitar tudo, recusar ou escolher categoria por categoria.
        </p>
      </div>
    </div>

    <!-- Painel de preferências (escondido por padrão) -->
    <div id="cookie-prefs" class="hidden mb-4 space-y-2 pb-4 border-b border-neutral-100">
      <label class="flex items-start gap-3 cursor-not-allowed opacity-70">
        <input type="checkbox" checked disabled class="mt-1 rounded" />
        <div class="text-sm">
          <div class="font-semibold text-neutral-900">Essenciais</div>
          <div class="text-neutral-500">Necessários para o site funcionar (não desativáveis).</div>
        </div>
      </label>
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" id="cookie-cat-analytics" class="mt-1 rounded" />
        <div class="text-sm">
          <div class="font-semibold text-neutral-900">Analytics</div>
          <div class="text-neutral-500">Google Analytics 4 — entender como você usa o site.</div>
        </div>
      </label>
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" id="cookie-cat-marketing" class="mt-1 rounded" />
        <div class="text-sm">
          <div class="font-semibold text-neutral-900">Marketing</div>
          <div class="text-neutral-500">Meta, TikTok, Google Ads — anúncios mais relevantes.</div>
        </div>
      </label>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <button
        type="button"
        class="btn btn--primary text-sm flex-1"
        data-cookie-action="accept_all"
      >
        Aceitar tudo
      </button>
      <button
        type="button"
        class="btn btn--ghost text-sm flex-1"
        data-cookie-action="reject_all"
      >
        Rejeitar
      </button>
      <button
        type="button"
        class="text-sm font-semibold text-neutral-700 hover:text-neutral-900 px-3 py-2 rounded-full transition-colors"
        data-cookie-action="toggle_prefs"
      >
        Configurar
      </button>
    </div>
  </div>
</div>

<style>
  /* Animação de entrada */
  #cookie-banner {
    animation: slide-up 400ms var(--ease-out-quart);
  }
  @keyframes slide-up {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @media (min-width: 768px) {
    @keyframes slide-up {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  }
</style>

<script>
  import { initTracking } from '../../scripts/tracking';

  const STORAGE_KEY = 'mc_cookie_consent';
  const CONSENT_DURATION = 365 * 24 * 60 * 60 * 1000; // 365 dias

  type ConsentDecision = {
    essential: true;
    analytics: boolean;
    marketing: boolean;
    timestamp: number;
  };

  function getStoredConsent(): ConsentDecision | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (Date.now() - parsed.timestamp > CONSENT_DURATION) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function storeConsent(decision: Omit<ConsentDecision, 'timestamp'>): void {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ ...decision, timestamp: Date.now() })
      );
    } catch {
      // localStorage indisponível
    }
  }

  function applyConsent(decision: ConsentDecision): void {
    // Carrega scripts de analytics/marketing dinamicamente conforme consentimento
    if (decision.analytics) {
      enableAnalytics();
    }
    if (decision.marketing) {
      enableMarketing();
    }
  }

  function enableAnalytics(): void {
    // GA4 — idem já carregado no <head> por padrão (não dinâmico)
    // Mantemos aqui só pra documentar
    document.documentElement.dataset.consentAnalytics = 'true';
  }

  function enableMarketing(): void {
    document.documentElement.dataset.consentMarketing = 'true';
    // Meta Pixel e outros são carregados dinamicamente
    loadMarketingScripts();
  }

  function loadMarketingScripts(): void {
    // Exemplo: Meta Pixel — pode ser carregado aqui se ainda não estiver
    if (typeof window.fbq === 'undefined') {
      // Inicialização controlada (não duplicar se já carregado)
      // ...
    }
  }

  function showBanner(): void {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;
    banner.classList.remove('hidden');
  }

  function hideBanner(): void {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;
    banner.classList.add('hidden');
  }

  function togglePrefs(): void {
    const prefs = document.getElementById('cookie-prefs');
    if (!prefs) return;
    prefs.classList.toggle('hidden');
  }

  function handleAcceptAll(): void {
    storeConsent({ essential: true, analytics: true, marketing: true });
    applyConsent({ essential: true, analytics: true, marketing: true, timestamp: Date.now() });
    hideBanner();
  }

  function handleRejectAll(): void {
    storeConsent({ essential: true, analytics: false, marketing: false });
    applyConsent({ essential: true, analytics: false, marketing: false, timestamp: Date.now() });
    hideBanner();
  }

  function handleSaveCustom(): void {
    const analyticsEl = document.getElementById('cookie-cat-analytics') as HTMLInputElement | null;
    const marketingEl = document.getElementById('cookie-cat-marketing') as HTMLInputElement | null;
    const analytics = analyticsEl?.checked ?? false;
    const marketing = marketingEl?.checked ?? false;
    storeConsent({ essential: true, analytics, marketing });
    applyConsent({ essential: true, analytics, marketing, timestamp: Date.now() });
    hideBanner();
  }

  function initCookieConsent(): void {
    const stored = getStoredConsent();

    if (stored) {
      // Já tem decisão prévia — aplicar e seguir
      applyConsent(stored);
      return;
    }

    // Mostrar banner após 1.5s para não atrapalhar LCP
    setTimeout(showBanner, 1500);

    // Delegação de eventos
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.dataset.cookieAction;
      if (!action) return;

      switch (action) {
        case 'accept_all':
          handleAcceptAll();
          break;
        case 'reject_all':
          handleRejectAll();
          break;
        case 'toggle_prefs':
          togglePrefs();
          // Trocar comportamento do botão "Configurar" para "Salvar" quando aberto
          const prefs = document.getElementById('cookie-prefs');
          if (prefs && !prefs.classList.contains('hidden')) {
            target.textContent = 'Salvar preferências';
            target.dataset.cookieAction = 'save_custom';
          } else if (target.dataset.cookieAction === 'save_custom') {
            target.textContent = 'Configurar';
            target.dataset.cookieAction = 'toggle_prefs';
          }
          break;
        case 'save_custom':
          handleSaveCustom();
          target.textContent = 'Configurar';
          target.dataset.cookieAction = 'toggle_prefs';
          break;
      }
    });

    // Sempre inicializa tracking de UTMs (essenciais, sem consentimento)
    initTracking();
  }

  initCookieConsent();
</script>