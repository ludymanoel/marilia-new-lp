---
/**
 * Testimonials — Depoimento destaque + grid com 6 cards.
 * Cada card simula print WhatsApp (mockup visual).
 */
import Icon from '../ui/Icon.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { testimonialsData } from '../../data/content';
---

<SectionWrapper id="depoimentos" theme="light" ariaLabelledby="testimonials-heading">
  <SectionHeading
    eyebrow={testimonialsData.eyebrow}
    title={testimonialsData.headline}
    align="center"
  />

  <!-- Depoimento destaque -->
  <article
    class="max-w-3xl mx-auto mt-12 md:mt-16 card border-2 border-brand-100 bg-gradient-to-br from-white to-brand-50 reveal"
  >
    <!-- Estrelas -->
    <div class="flex gap-1 mb-4" aria-label="Avaliação 5 de 5 estrelas">
      {[1, 2, 3, 4, 5].map(() => (
        <Icon name="star" size={20} class="text-accent-500" />
      ))}
    </div>

    <blockquote class="text-xl md:text-2xl font-display text-neutral-900 leading-relaxed mb-6">
      "{testimonialsData.featured.quote}"
    </blockquote>

    <footer class="flex items-center gap-3 pt-4 border-t border-neutral-200">
      <div class="w-12 h-12 rounded-full bg-brand-200 flex items-center justify-center font-display font-bold text-brand-800">
        {testimonialsData.featured.author.charAt(0)}
      </div>
      <div>
        <div class="font-semibold text-neutral-900">
          {testimonialsData.featured.author}
        </div>
        <div class="text-sm text-neutral-600">
          {testimonialsData.featured.role}
        </div>
      </div>
    </footer>
  </article>

  <!-- Grid de depoimentos secundários -->
  <ul
    class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mt-8 stagger"
    role="list"
  >
    {testimonialsData.grid.map((testimonial) => (
      <li class="card card--hover border border-neutral-100 reveal">
        <div class="flex gap-1 mb-3" aria-label="Avaliação 5 de 5 estrelas">
          {[1, 2, 3, 4, 5].map(() => (
            <Icon name="star" size={14} class="text-accent-500" />
          ))}
        </div>
        <p class="text-neutral-700 leading-relaxed mb-4 italic">
          "{testimonial.quote}"
        </p>
        <footer class="pt-3 border-t border-neutral-100 flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-accent-100 flex items-center justify-center text-xs font-bold text-accent-700">
            {testimonial.author.charAt(0)}
          </div>
          <div>
            <div class="text-sm font-semibold text-neutral-900">
              {testimonial.author}
            </div>
            <div class="text-xs text-neutral-500">
              {testimonial.role}
            </div>
          </div>
        </footer>
      </li>
    ))}
  </ul>

  <p class="text-center mt-10 text-neutral-700 font-semibold reveal">
    {testimonialsData.footer}
  </p>
</SectionWrapper>