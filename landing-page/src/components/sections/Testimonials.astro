---
/**
 * Testimonials — 6 vídeos YouTube (lite embed) + 10 prints WhatsApp reais.
 * Dados oficiais da LP original.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import LiteYouTube from '../ui/LiteYouTube.astro';
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import {
  testimonialsData,
  videosTestimonialsData,
  whatsappTestimonialsData,
} from '../../data/content';
---

<SectionWrapper id="depoimentos" theme="light" ariaLabelledby="testimonials-heading">
  <SectionHeading
    eyebrow={testimonialsData.eyebrow}
    title={testimonialsData.headline}
    subtitle={testimonialsData.introduction}
    align="center"
  />

  <!-- Grid de 6 vídeos lite-embed (YouTube thumbnails reais) -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12 md:mt-16 stagger">
    {videosTestimonialsData.map((video, idx) => (
      <LiteYouTube
        videoId={video.id}
        title={video.title}
        startAt={video.startAt}
        thumbnailUrl={`/images/thumbs/video-${idx + 1}.${idx === 2 ? 'jpg' : 'jpeg'}`}
      />
    ))}
  </div>

  <!-- Divisor -->
  <div class="my-12 md:my-16 flex items-center gap-4 max-w-3xl mx-auto">
    <div class="flex-1 h-px bg-neutral-200"></div>
    <span class="text-xs uppercase tracking-widest text-neutral-700 font-semibold">
      E por WhatsApp também
    </span>
    <div class="flex-1 h-px bg-neutral-200"></div>
  </div>

  <!-- Grid de prints WhatsApp reais -->
  <ul
    class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-4 md:gap-6 stagger max-w-5xl mx-auto"
    role="list"
  >
    {whatsappTestimonialsData.map((print) => {
      const num = print.src.match(/(\d+)\.jpeg/)?.[1];
      return (
        <li class="reveal">
          <SmartImage
            webp={num ? `/images/depoimentos/${num.padStart(2, '0')}.webp` : undefined}
            fallback={print.src}
            alt={print.alt}
            loading="lazy"
            class="w-full h-auto rounded-2xl shadow-soft hover:shadow-medium transition-shadow duration-300"
          />
        </li>
      );
    })}
  </ul>

  <p class="text-center mt-10 text-neutral-700 font-semibold reveal">
    {testimonialsData.footer}
  </p>
</SectionWrapper>