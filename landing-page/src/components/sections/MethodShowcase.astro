---
/**
 * MethodShowcase — Galeria de mockups reais do curso.
 * Mostra o método em diferentes dispositivos (sonhatividade, smartphone, tablet,
 * comunidade, etc.).
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const mockups = [
  {
    src: '/images/mockups/sonhatividade-1.webp',
    alt: 'Sonhatividade — fórmula do método',
    title: 'A fórmula SONHA',
    description: 'Sonhar, Organizar, Narrar, Haver, Agir. O framework que transforma intenção em execução.',
  },
  {
    src: '/images/mockups/smartphone.webp',
    alt: 'Curso no smartphone',
    title: 'Aprenda no seu ritmo',
    description: 'Aulas de 5 a 15 minutos, no celular, tablet ou notebook. Pelo computador, mais concentração.',
  },
  {
    src: '/images/mockups/curso-1.webp',
    alt: 'Curso Produtividade Sincera em dispositivos',
    title: 'Onde você estiver',
    description: 'Método completo em multi-formato. Estude no seu ritmo, com o poder do replay.',
  },
  {
    src: '/images/mockups/comunidade.webp',
    alt: 'Comunidade de alunas',
    title: 'Comunidade ativa',
    description: 'Você não está sozinha. Troque experiências, tire dúvidas, celebre conquistas.',
  },
];
---

<SectionWrapper theme="light" ariaLabelledby="showcase-heading">
  <SectionHeading
    eyebrow="O método na prática"
    title="Veja o Produtividade Sincera em ação"
    subtitle="Aulas práticas, ferramentas autorais, comunidade ativa. Tudo o que você precisa pra organizar sua vida em 30 dias."
    align="center"
  />

  <div class="grid sm:grid-cols-2 gap-6 md:gap-8 mt-12 md:mt-16 max-w-5xl mx-auto stagger">
    {mockups.map((mockup, idx) => (
      <article class="group reveal">
        <div class="rounded-2xl overflow-hidden bg-white shadow-soft hover:shadow-medium transition-shadow duration-300">
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={mockup.src}
              alt={mockup.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
        </div>
        <div class="mt-4 px-1">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-semibold uppercase tracking-widest text-brand-600">
              0{idx + 1}
            </span>
            <span class="text-neutral-300">·</span>
            <span class="text-xs uppercase tracking-widest text-neutral-500">Mockup</span>
          </div>
          <h3 class="text-xl font-display font-semibold text-neutral-900 mb-1">
            {mockup.title}
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            {mockup.description}
          </p>
        </div>
      </article>
    ))}
  </div>
</SectionWrapper>