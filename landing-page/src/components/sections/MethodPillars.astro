---
/**
 * MethodPillars — 4 pilares do método Sonhatividade.
 * Visual numerado (01-04), grid 2x2 mobile / 4x1 desktop.
 */
import Icon from '../ui/Icon.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { methodPillarsData } from '../../data/content';
---

<SectionWrapper id="metodo" theme="light" ariaLabelledby="method-heading">
  <SectionHeading
    eyebrow={methodPillarsData.eyebrow}
    title={methodPillarsData.headline}
    subtitle={methodPillarsData.subheadline}
    align="center"
  />

  <ol
    class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12 md:mt-16 stagger"
    role="list"
  >
    {methodPillarsData.pillars.map((pillar) => (
      <li class="card card--hover relative overflow-hidden border border-neutral-100 reveal">
        <!-- Background accent -->
        <div
          class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-brand-50 opacity-50"
          aria-hidden="true"
        ></div>

        <div class="relative">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-display text-5xl font-bold text-brand-200 leading-none">
              {pillar.number}
            </span>
            <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center">
              <Icon name={pillar.icon as any} size={24} />
            </div>
          </div>

          <h3 class="text-2xl font-display font-semibold text-neutral-900 mb-3">
            {pillar.title}.
          </h3>
          <p class="text-neutral-600 leading-relaxed">
            {pillar.description}
          </p>
        </div>
      </li>
    ))}
  </ol>
</SectionWrapper>