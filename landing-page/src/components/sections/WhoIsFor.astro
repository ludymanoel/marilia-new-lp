---
/**
 * WhoIsFor — 3 personas (texto puro, sem avatares SVG).
 * Reforça identificação: "se você é assim, continue".
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { whoIsForData } from '../../data/content';
---

<SectionWrapper id="para-quem" theme="soft" ariaLabelledby="who-heading">
  <SectionHeading
    eyebrow={whoIsForData.eyebrow}
    title={whoIsForData.headline}
    align="center"
  />

  <ul
    class="grid md:grid-cols-3 gap-6 mt-12 md:mt-16 stagger"
    role="list"
  >
    {whoIsForData.cards.map((card) => (
      <li class="card card--hover border border-neutral-100 reveal">
        <p class="text-neutral-700 leading-relaxed">
          <span class="font-semibold text-neutral-900">{card.title}</span>
          {card.description.replace(card.title, '')}
        </p>
      </li>
    ))}
  </ul>
</SectionWrapper>