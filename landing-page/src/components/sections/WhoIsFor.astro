---
/**
 * WhoIsFor — 3 personas com avatares SVG ilustrados.
 * Reforça identificação: "se você é assim, continue".
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { whoIsForData } from '../../data/content';

// Avatares SVG estilizados (sem dependência de imagens externas)
const avatarMap = {
  carla: { hair: '#3D2817', skin: '#F4D5B5', shirt: '#6366F1', accessory: 'glasses' },
  renata: { hair: '#8B4513', skin: '#E8C5A0', shirt: '#F59E0B', accessory: 'laptop' },
  julia: { hair: '#1F1F1F', skin: '#F4D5B5', shirt: '#10B981', accessory: 'coffee' },
};
---

<SectionWrapper id="para-quem" theme="soft" ariaLabelledby="who-heading">
  <SectionHeading
    eyebrow={whoIsForData.eyebrow}
    title={whoIsForData.headline}
    align="center"
  />

  <ul
    class="grid md:grid-cols-3 gap-6 mt-12 md:mt-16 stagger"
    role="list"
  >
    {whoIsForData.cards.map((card, idx) => {
      const palette = avatarMap[card.avatar as keyof typeof avatarMap];
      return (
        <li class="card card--hover border border-neutral-100 reveal">
          <!-- Avatar SVG ilustrado -->
          <div class="flex items-center gap-4 mb-4">
            <svg
              width="64"
              height="64"
              viewBox="0 0 64 64"
              class="flex-shrink-0"
              aria-hidden="true"
            >
              <!-- Cabeça -->
              <circle cx="32" cy="26" r="14" fill={palette.skin} />
              <!-- Cabelo -->
              <path
                d={`M18 24 Q18 12 32 12 Q46 12 46 24 L46 28 L42 26 L38 28 L34 26 L30 28 L26 26 L22 28 L18 26 Z`}
                fill={palette.hair}
              />
              <!-- Olhos -->
              <circle cx="27" cy="27" r="1.5" fill="#1F1F1F" />
              <circle cx="37" cy="27" r="1.5" fill="#1F1F1F" />
              <!-- Sorriso -->
              <path
                d="M28 32 Q32 35 36 32"
                stroke="#1F1F1F"
                stroke-width="1.5"
                fill="none"
                stroke-linecap="round"
              />
              <!-- Corpo/shoulders -->
              <path
                d="M14 56 Q14 44 32 42 Q50 44 50 56 Z"
                fill={palette.shirt}
              />
              <!-- Acessório -->
              {palette.accessory === 'glasses' && (
                <g stroke="#1F1F1F" stroke-width="1.5" fill="none">
                  <circle cx="27" cy="27" r="3" />
                  <circle cx="37" cy="27" r="3" />
                  <line x1="30" y1="27" x2="34" y2="27" />
                </g>
              )}
              {palette.accessory === 'laptop' && (
                <rect x="44" y="48" width="12" height="8" rx="1" fill="#1F1F1F" opacity="0.7" />
              )}
              {palette.accessory === 'coffee' && (
                <g>
                  <rect x="44" y="46" width="8" height="10" rx="1" fill="#FFFFFF" />
                  <rect x="44" y="46" width="8" height="3" fill="#8B4513" />
                </g>
              )}
            </svg>

            <div class="text-xs font-semibold uppercase tracking-widest text-brand-600">
              Persona 0{idx + 1}
            </div>
          </div>

          <p class="text-neutral-700 leading-relaxed">
            <span class="font-semibold text-neutral-900">{card.title}</span>
            {card.description.replace(card.title, '')}
          </p>
        </li>
      );
    })}
  </ul>

  <p class="text-center mt-10 md:mt-12 text-neutral-600 italic reveal">
    {whoIsForData.footerCta}
  </p>
</SectionWrapper>