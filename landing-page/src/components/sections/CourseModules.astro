---
/**
 * CourseModules — 6 módulos em accordion usando `<details>` nativo (A11y perfeito).
 * Tempo total destacado no rodapé.
 */
import Icon from '../ui/Icon.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { courseModulesData } from '../../data/content';
---

<SectionWrapper id="conteudo" theme="light" ariaLabelledby="modules-heading">
  <SectionHeading
    eyebrow={courseModulesData.eyebrow}
    title={courseModulesData.headline}
    subtitle={courseModulesData.subheadline}
    align="center"
  />

  <div class="max-w-3xl mx-auto mt-12 md:mt-16 space-y-3 stagger">
    {courseModulesData.modules.map((module) => (
      <details class="accordion-item reveal group">
        <summary>
          <span class="flex items-center gap-4 flex-1">
            <span class="font-display text-2xl font-bold text-brand-300 tabular-nums">
              {module.number}
            </span>
            <span class="flex-1 text-left">
              <span class="block">{module.title}</span>
              <span class="block text-xs text-neutral-500 font-normal mt-0.5">
                {module.duration}
              </span>
            </span>
          </span>
        </summary>
        <div class="accordion-content">
          <p class="mb-4">{module.description}</p>
          <ul class="space-y-2" role="list">
            {module.lessons.map((lesson) => (
              <li class="flex items-start gap-2 text-sm">
                <Icon name="play" size={16} class="flex-shrink-0 mt-0.5 text-brand-500" />
                <span>{lesson}</span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))}
  </div>

  <div class="text-center mt-12 reveal">
    <div class="inline-flex items-center gap-3 bg-brand-50 text-brand-800 rounded-full px-5 py-2 font-semibold mb-6">
      <Icon name="clock" size={18} />
      <span>Total: {courseModulesData.totalDuration} de conteúdo prático</span>
    </div>
    <div>
      <Button variant="primary" href="#oferta" size="lg">
        {courseModulesData.cta}
      </Button>
    </div>
  </div>
</SectionWrapper>