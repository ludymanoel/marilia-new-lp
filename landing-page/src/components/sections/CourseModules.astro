---
/**
 * CourseModules — 10 módulos em 3 blocos temáticos (accordion) + mockup visual do curso.
 */
import Icon from '../ui/Icon.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { courseModulesData } from '../../data/content';
---

<SectionWrapper id="conteudo" theme="light" ariaLabelledby="modules-heading">
  <SectionHeading
    eyebrow={courseModulesData.eyebrow}
    title={courseModulesData.headline}
    subtitle={courseModulesData.subheadline}
    align="center"
  />

  <div class="grid lg:grid-cols-[1fr_400px] gap-10 lg:gap-12 mt-12 md:mt-16 items-start">
    <!-- Accordion de módulos agrupado em blocos -->
    <div class="space-y-10 stagger">
      {courseModulesData.blocks.map((block) => (
        <section aria-labelledby={`module-block-${block.title}`}>
          <h3
            id={`module-block-${block.title}`}
            class="text-sm md:text-base text-brand-700 font-display font-semibold uppercase tracking-widest mb-4"
          >
            {block.title}
          </h3>
          <div class="space-y-3">
            {block.modules.map((module) => (
              <details class="accordion-item reveal group">
                <summary>
                  <span class="flex items-center gap-4 flex-1">
                    <span class="font-display text-2xl font-bold text-brand-300 tabular-nums">
                      {module.number}
                    </span>
                    <span class="flex-1 text-left">
                      <span class="block">{module.title}</span>
                    </span>
                  </span>
                  <Icon
                    name="chevron-down"
                    size={20}
                    class="flex-shrink-0 text-brand-500 transition-transform duration-200 group-open:rotate-180"
                  />
                </summary>
                <div class="accordion-content">
                  <p class="mb-4">{module.description}</p>
                  <ul class="space-y-2" role="list">
                    {module.lessons.map((lesson) => (
                      <li class="flex items-start gap-2 text-sm">
                        <Icon name="play" size={16} class="flex-shrink-0 mt-0.5 text-brand-500" />
                        <span>{lesson}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Mockup visual do curso (imagem oficial) -->
    <div class="reveal lg:sticky lg:top-24">
      <div class="rounded-2xl overflow-hidden shadow-large bg-white p-3">
        <picture>
          <source srcset="/images/mockups/curso-1.webp" type="image/webp" />
          <img
            src="/images/mockups/curso-1.png"
            alt="Mockup do curso Produtividade Sincera — visualizado em dispositivos"
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-xl"
          />
        </picture>
      </div>
      <div class="mt-6 text-center">
        <div class="inline-flex items-center gap-3 bg-brand-50 text-brand-800 rounded-full px-5 py-2 font-semibold mb-4">
          <Icon name="clock" size={18} />
          <span>Total: {courseModulesData.totalDuration} de conteúdo prático</span>
        </div>
        <div>
          <Button variant="primary" href="#oferta" size="lg" data-track-cta="modules_cta">
            {courseModulesData.cta}
          </Button>
        </div>
      </div>
    </div>
  </div>
</SectionWrapper>