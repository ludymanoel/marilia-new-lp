---
/**
 * AboutMarilia — Seção de autoridade. Usa logo fractal como marca
 * até que a foto oficial seja fornecida pela cliente.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import LogoMC from '../ui/LogoMC.astro';
import { aboutMariliaData } from '../../data/content';
---

<SectionWrapper id="sobre" theme="soft" ariaLabelledby="about-heading">
  <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-center">
    <!-- Copy -->
    <div class="lg:col-span-3 order-2 lg:order-1">
      <SectionHeading
        eyebrow={aboutMariliaData.eyebrow}
        title={aboutMariliaData.headline}
        align="left"
      />

      <div class="space-y-4 mt-8 text-lg text-neutral-700 leading-relaxed reveal">
        {aboutMariliaData.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <!-- Stats grid -->
      <ul class="grid sm:grid-cols-3 gap-4 mt-10 stagger" role="list">
        {aboutMariliaData.stats.map((stat) => (
          <li class="bg-white border border-neutral-200 rounded-xl p-4 text-center card--hover reveal">
            <div class="font-display text-2xl md:text-3xl font-bold text-brand-600 tabular-nums">
              {stat.value}
            </div>
            <div class="text-xs text-neutral-600 mt-1 leading-tight">
              {stat.label}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Logo fractal oficial como placeholder visual -->
    <div class="lg:col-span-2 order-1 lg:order-2 reveal">
      <div class="relative">
        <div class="aspect-[4/5] bg-gradient-fractal rounded-2xl overflow-hidden shadow-large flex flex-col items-center justify-center p-8">
          <LogoMC
            variant="color"
            size="xl"
            showText={true}
            class="max-w-full h-auto"
          />
        </div>
        <!-- Badge decorativa -->
        <div
          class="absolute -bottom-4 -left-4 bg-yellow-500 text-brand-900 px-4 py-2 rounded-full font-bold text-sm shadow-lg"
          aria-hidden="true"
        >
          +12 anos de método
        </div>
      </div>
    </div>
  </div>
</SectionWrapper>