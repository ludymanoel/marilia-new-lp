---
/**
 * AboutMarilia — Seção de autoridade. Foto + bio + estatísticas.
 */
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { aboutMariliaData } from '../../data/content';
---

<SectionWrapper id="sobre" theme="soft" ariaLabelledby="about-heading">
  <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-center">
    <!-- Copy -->
    <div class="lg:col-span-3 order-2 lg:order-1">
      <SectionHeading
        eyebrow={aboutMariliaData.eyebrow}
        title={aboutMariliaData.headline}
        align="left"
      />

      <div class="space-y-4 mt-8 text-lg text-neutral-700 leading-relaxed reveal">
        {aboutMariliaData.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <!-- Stats grid -->
      <ul class="grid sm:grid-cols-3 gap-4 mt-10 stagger" role="list">
        {aboutMariliaData.stats.map((stat) => (
          <li class="bg-white border border-neutral-200 rounded-xl p-4 text-center card--hover reveal">
            <div class="font-display text-2xl md:text-3xl font-bold text-brand-700 tabular-nums">
              {stat.value}
            </div>
            <div class="text-xs text-neutral-600 mt-1 leading-tight">
              {stat.label}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Foto -->
    <div class="lg:col-span-2 order-1 lg:order-2 reveal">
      <div class="relative">
        <div
          class="aspect-[4/5] rounded-2xl overflow-hidden bg-gradient-to-br from-brand-100 to-accent-100 shadow-large"
          aria-label="Foto de Marília Cordeiro"
        >
          <!-- Placeholder visual até a foto real ser fornecida.
               Quando /public/images/marilia-perfil.webp existir,
               descomentar o bloco abaixo. -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center">
              <div class="w-32 h-32 mx-auto rounded-full bg-brand-200 flex items-center justify-center mb-4">
                <Icon name="sparkles" size={48} class="text-brand-700" />
              </div>
              <p class="text-brand-800 font-display font-semibold text-lg">
                Marília Cordeiro
              </p>
              <p class="text-brand-600 text-sm mt-1">
                Foto em /public/images/
              </p>
            </div>
          </div>
        </div>
        <!-- Badge decorativa -->
        <div
          class="absolute -bottom-4 -left-4 bg-accent-500 text-neutral-900 px-4 py-2 rounded-full font-bold text-sm shadow-lg"
          aria-hidden="true"
        >
          +12 anos de método
        </div>
      </div>
    </div>
  </div>
</SectionWrapper>