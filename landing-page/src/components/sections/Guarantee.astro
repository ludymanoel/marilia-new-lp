---
/**
 * Guarantee — Selo visual oficial (SVG) + texto da LP original.
 * Bloco com imagem real + texto âncora visual.
 */
import Icon from '../ui/Icon.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import { guaranteeData } from '../../data/content';
---

<SectionWrapper theme="light" ariaLabelledby="guarantee-heading">
  <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-5xl mx-auto">
    <!-- Coluna do selo (oficial) -->
    <div class="text-center reveal">
      <img
        src="/images/guarantee-seal.svg"
        alt="Selo de garantia 7 dias — 100% do seu dinheiro de volta"
        width="200"
        height="200"
        loading="lazy"
        decoding="async"
        class="w-48 h-48 md:w-56 md:h-56 mx-auto"
      />
    </div>

    <!-- Coluna do texto -->
    <div class="reveal">
      <span class="badge badge--brand mb-4">
        <Icon name="shield-check" size={14} />
        Garantia 7 dias
      </span>
      <h2 id="guarantee-heading" class="mb-4">
        Risco zero pra você.
      </h2>
      <div class="space-y-3 text-neutral-700 leading-relaxed">
        {guaranteeData.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <a
        href={guaranteeData.ctaHref}
        class="inline-flex items-center gap-2 mt-6 text-brand-700 font-semibold hover:text-brand-900 transition-colors"
      >
        {guaranteeData.cta}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</SectionWrapper>